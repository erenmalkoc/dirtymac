{
  "sourceLanguage": "en",
  "strings": {
    "%@ is using secure input, so macOS won't let dirtymac block keys.": {
      "comment": "Warning in the panel while another app holds Secure Event Input (a focused password field, Terminal's Secure Keyboard Entry). %@ is that app's name.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwendet die sichere Eingabe, daher lässt macOS dirtymac keine Tasten blockieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is using secure input, so macOS won't let dirtymac block keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está usando la entrada segura, así que macOS no deja que dirtymac bloquee las teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise la saisie sécurisée, donc macOS empêche dirtymac de bloquer les touches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sta usando l’inserimento sicuro, quindi macOS non permette a dirtymac di bloccare i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がセキュア入力を使用しているため、macOS は dirtymac によるキーのブロックを許可しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 보안 입력을 사용 중이므로 macOS가 dirtymac의 키 차단을 허용하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está usando a entrada segura, então o macOS não permite que o dirtymac bloqueie as teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ использует защищённый ввод, поэтому macOS не даёт dirtymac блокировать клавиши."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ güvenli girişi kullanıyor; bu yüzden macOS, dirtymac'in tuşları engellemesine izin vermiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”正在使用安全输入，因此 macOS 不允许 dirtymac 拦截按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」正在使用安全輸入，因此 macOS 不允許 dirtymac 攔截按鍵。"
          }
        }
      }
    },
    "A fresh keycap icon, and a menu bar glyph that turns red while the keyboard is locked.": {
      "comment": "What's New 1.3.0 item detail.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neues Tastenkappen-Symbol und ein Menüleistensymbol, das rot wird, solange die Tastatur gesperrt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fresh keycap icon, and a menu bar glyph that turns red while the keyboard is locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuevo icono de tecla y un símbolo en la barra de menús que se vuelve rojo mientras el teclado está bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle icône en forme de touche, et un symbole dans la barre des menus qui devient rouge quand le clavier est verrouillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nuova icona a forma di tasto e un simbolo nella barra dei menu che diventa rosso mentre la tastiera è bloccata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいキーキャップのアイコンと、キーボードのロック中に赤くなるメニューバーのアイコン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 키캡 아이콘과 키보드가 잠겨 있는 동안 빨간색으로 바뀌는 메뉴 막대 아이콘."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo ícone de tecla e um símbolo na barra de menus que fica vermelho enquanto o teclado está bloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый значок в виде клавиши и значок в строке меню, который краснеет, пока клавиатура заблокирована."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yepyeni bir tuş simgesi ve klavye kilitliyken kırmızıya dönen bir menü çubuğu simgesi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全新的键帽图标，以及键盘锁定时会变红的菜单栏图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全新的鍵帽圖像，以及鍵盤鎖定時會變紅的選單列圖像。"
          }
        }
      }
    },
    "A menu bar utility that locks your keyboard so you can clean it — without typing nonsense or launching apps.": {
      "comment": "Onboarding step 1 body.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Menüleisten-Tool, das deine Tastatur sperrt, damit du sie reinigen kannst – ohne Unsinn zu tippen oder Apps zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A menu bar utility that locks your keyboard so you can clean it — without typing nonsense or launching apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una utilidad de la barra de menús que bloquea el teclado para que puedas limpiarlo, sin escribir tonterías ni abrir apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un utilitaire de la barre des menus qui verrouille votre clavier pour que vous puissiez le nettoyer, sans taper n'importe quoi ni lancer d'apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'utility nella barra dei menu che blocca la tastiera così puoi pulirla, senza digitare cose a caso o avviare app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーからキーボードをロックし、無駄な入力やアプリの起動なしに掃除できるユーティリティです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 키보드를 잠가, 엉뚱한 입력이나 앱 실행 없이 청소할 수 있게 해 주는 유틸리티입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um utilitário da barra de menus que bloqueia o teclado para você limpá-lo — sem digitar bobagens nem abrir apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Утилита в строке меню, которая блокирует клавиатуру, чтобы вы могли её почистить — без случайного ввода и запуска приложений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenizi kilitleyip, saçma tuşlara basmadan veya uygulama açmadan temizlemenizi sağlayan bir menü çubuğu aracı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个菜单栏小工具，锁定键盘以便清洁，不会输入乱码或误开应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個選單列小工具，鎖定鍵盤以便清潔，不會輸入亂碼或誤開 App。"
          }
        }
      }
    },
    "Accessibility access granted": {
      "comment": "Onboarding step 2 live status — granted.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
