          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac heeft toestemming nodig om toetsenbordgebeurtenissen te onderscheppen terwijl je schoonmaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac potrzebuje uprawnienia, aby przechwytywać zdarzenia klawiatury podczas czyszczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dirtymac precisa de permissão para interceptar eventos do teclado enquanto você limpa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac требуется разрешение для перехвата событий клавиатуры во время очистки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac, sen temizlerken klavye olaylarını engelleyebilmek için izne ihtiyaç duyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac потрібен дозвіл перехоплювати події клавіатури під час чищення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac cần quyền để chặn các sự kiện bàn phím trong lúc bạn vệ sinh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac 需要权限以在清洁时拦截键盘事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac 需要權限以在清潔時攔截鍵盤事件。"
          }
        }
      }
    },
    "dirtymac now tells you when a password field or Terminal keeps it from blocking keys.": {
      "comment": "What's New 1.3.0 item detail.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac sagt dir jetzt, wenn ein Passwortfeld oder das Terminal verhindert, dass Tasten blockiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac now tells you when a password field or Terminal keeps it from blocking keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac ahora te avisa cuando un campo de contraseña o Terminal le impide bloquear las teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac vous prévient désormais quand un champ de mot de passe ou Terminal l’empêche de bloquer les touches."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac kini memberi tahu saat kolom kata sandi atau Terminal menghalangi pemblokiran tombol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac ora ti avvisa quando un campo password o il Terminale gli impedisce di bloccare i tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワード欄やターミナルのせいでキーをブロックできないとき、dirtymac がお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호 입력란이나 터미널 때문에 키를 차단할 수 없을 때 dirtymac이 알려 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac meldt nu wanneer een wachtwoordveld of Terminal het blokkeren van toetsen verhindert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac informuje teraz, gdy pole hasła lub Terminal uniemożliwia blokowanie klawiszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dirtymac agora avisa quando um campo de senha ou o Terminal impede o bloqueio das teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь dirtymac сообщает, когда поле пароля или Терминал мешают блокировать клавиши."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac artık bir parola alanı ya da Terminal tuşları engellemesini önlediğinde size haber veriyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер dirtymac повідомляє, коли поле пароля або Термінал заважає блокувати клавіші."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac giờ sẽ báo khi một ô mật khẩu hoặc Terminal khiến nó không chặn được phím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当密码栏或“终端”阻止 dirtymac 拦截按键时，它现在会提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當密碼欄位或「終端機」讓 dirtymac 無法攔截按鍵時，它現在會提醒你。"
          }
        }
      }
    },
    "dirtymac stays offline unless you turn on update checks in Settings. Then it tells you when a new version is out.": {
      "comment": "What's New item text for version 1.4.0.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac bleibt offline, solange du die Update-Prüfung nicht in den Einstellungen einschaltest. Dann sagt es dir Bescheid, wenn eine neue Version erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac stays offline unless you turn on update checks in Settings. Then it tells you when a new version is out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac sigue sin conexión mientras no actives la comprobación de actualizaciones en Ajustes. Entonces te avisa cuando sale una versión nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac reste hors ligne tant que vous n'activez pas la recherche de mises à jour dans les Réglages. Il vous prévient alors lorsqu'une nouvelle version est disponible."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac tetap offline kecuali Anda mengaktifkan pemeriksaan pembaruan di Pengaturan. Setelah itu, ia memberi tahu saat versi baru tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac resta offline finché non attivi il controllo degli aggiornamenti in Impostazioni. Poi ti avvisa quando esce una nuova versione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でアップデートの確認をオンにしない限り、dirtymac はオフラインのままです。オンにすると、新しいバージョンが出たときにお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 업데이트 확인을 켜지 않으면 dirtymac은 계속 오프라인으로 동작합니다. 켜면 새 버전이 나왔을 때 알려 드립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac blijft offline tenzij je updatecontrole inschakelt in Instellingen. Daarna laat het weten wanneer er een nieuwe versie is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac pozostaje offline, dopóki nie włączysz sprawdzania aktualizacji w Ustawieniach. Wtedy powiadomi Cię o nowej wersji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dirtymac continua offline, a menos que você ative a verificação de atualizações em Ajustes. Depois disso, ele avisa quando houver uma nova versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac остаётся без подключения к интернету, пока вы не включите проверку обновлений в настройках. После этого он сообщит, когда выйдет новая версия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'dan güncelleme denetimini açmadığınız sürece dirtymac çevrimdışı kalır. Açarsanız yeni bir sürüm çıktığında sizi haberdar eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac залишається офлайн, доки ви не ввімкнете перевірку оновлень у Налаштуваннях. Тоді він повідомить про нову версію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac luôn ngoại tuyến trừ khi bạn bật kiểm tra cập nhật trong Cài đặt. Khi đó nó sẽ báo khi có phiên bản mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非您在“设置”中开启更新检查，否则 dirtymac 会一直保持离线。开启后，有新版本时它会通知您。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非您在「設定」中開啟更新檢查，否則 dirtymac 會一直保持離線。開啟後，有新版本時它會通知您。"
          }
        }
      }
    },
    "dirtymac takes your privacy seriously, so it stays offline by default. If you like, you can allow it to check once a day whether a new version is out. Only the latest version number is requested from GitHub. No personal data or usage information leaves your Mac. As with any web request, GitHub can see your IP address.": {
      "comment": "Privacy note under the update-check toggle, also shown in the What's New window. It must stay accurate: it is the promise the README makes.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac nimmt deine Privatsphäre ernst und bleibt deshalb standardmäßig offline. Wenn du möchtest, kannst du erlauben, dass es einmal täglich prüft, ob eine neue Version erschienen ist. Dabei wird nur die neueste Versionsnummer bei GitHub abgefragt. Es verlassen keine persönlichen Daten und keine Nutzungsinformationen deinen Mac. Wie bei jeder Webanfrage kann GitHub deine IP-Adresse sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac takes your privacy seriously, so it stays offline by default. If you like, you can allow it to check once a day whether a new version is out. Only the latest version number is requested from GitHub. No personal data or usage information leaves your Mac. As with any web request, GitHub can see your IP address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac se toma tu privacidad muy en serio, por eso funciona sin conexión de forma predeterminada. Si quieres, puedes permitirle comprobar una vez al día si hay una versión nueva. Solo se pide a GitHub el número de la última versión. Ningún dato personal ni información de uso sale de tu Mac. Como en cualquier solicitud web, GitHub puede ver tu dirección IP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac prend votre vie privée très au sérieux, c'est pourquoi il reste hors ligne par défaut. Si vous le souhaitez, vous pouvez l'autoriser à vérifier une fois par jour si une nouvelle version est disponible. Seul le numéro de la dernière version est demandé à GitHub. Aucune donnée personnelle ni information d'utilisation ne quitte votre Mac. Comme pour toute requête web, GitHub peut voir votre adresse IP."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac sangat menjaga privasi Anda, sehingga secara default tetap offline. Jika mau, Anda dapat mengizinkannya memeriksa sekali sehari apakah ada versi baru. Hanya nomor versi terbaru yang diminta dari GitHub. Tidak ada data pribadi atau informasi penggunaan yang keluar dari Mac Anda. Seperti permintaan web lainnya, GitHub dapat melihat alamat IP Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac tiene molto alla tua privacy, quindi per impostazione predefinita resta offline. Se vuoi, puoi consentirgli di controllare una volta al giorno se è uscita una nuova versione. A GitHub viene richiesto solo il numero dell'ultima versione. Nessun dato personale né informazione d'uso lascia il tuo Mac. Come per qualsiasi richiesta web, GitHub può vedere il tuo indirizzo IP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac はプライバシーを大切にするため、初期設定ではオフラインで動作します。ご希望であれば、新しいバージョンが出ているかを1日1回確認するよう許可できます。GitHub に問い合わせるのは最新のバージョン番号だけです。個人データや使用状況の情報が Mac の外に出ることはありません。Web リクエストの常として、GitHub には IP アドレスが見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac은 개인정보를 소중히 여기므로 기본적으로 오프라인으로 동작합니다. 원하시면 하루에 한 번 새 버전이 나왔는지 확인하도록 허용할 수 있습니다. GitHub에는 최신 버전 번호만 요청합니다. 개인 정보나 사용 정보는 Mac 밖으로 나가지 않습니다. 모든 웹 요청과 마찬가지로 GitHub에서는 IP 주소를 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac neemt je privacy serieus en blijft daarom standaard offline. Als je wilt, kun je toestaan dat het één keer per dag controleert of er een nieuwe versie is. Alleen het nummer van de nieuwste versie wordt bij GitHub opgevraagd. Er verlaten geen persoonsgegevens of gebruiksinformatie je Mac. Zoals bij elk webverzoek kan GitHub je IP-adres zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac poważnie traktuje Twoją prywatność, dlatego domyślnie działa offline. Jeśli chcesz, możesz pozwolić mu raz dziennie sprawdzać, czy dostępna jest nowa wersja. Z GitHuba pobierany jest tylko numer najnowszej wersji. Żadne dane osobowe ani informacje o użytkowaniu nie opuszczają Twojego Maca. Jak przy każdym zapytaniu sieciowym, GitHub widzi Twój adres IP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dirtymac leva sua privacidade a sério, por isso fica offline por padrão. Se quiser, você pode permitir que ele verifique uma vez por dia se há uma nova versão. Apenas o número da versão mais recente é solicitado ao GitHub. Nenhum dado pessoal nem informação de uso sai do seu Mac. Como em qualquer solicitação web, o GitHub pode ver seu endereço IP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac серьёзно относится к вашей конфиденциальности, поэтому по умолчанию работает без подключения к интернету. При желании вы можете разрешить ему раз в сутки проверять, вышла ли новая версия. У GitHub запрашивается только номер последней версии. Личные данные и сведения об использовании не покидают ваш Mac. Как и при любом веб-запросе, GitHub видит ваш IP-адрес."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac gizliliğinize büyük önem verir, bu yüzden varsayılan olarak çevrimdışı çalışır. İsterseniz internet bağlantısına izin verip yeni sürümlerden haberdar olabilirsiniz. Denetim günde en fazla bir kez yapılır. GitHub'dan yalnızca en son sürüm numarası istenir. Mac'inizden hiçbir kişisel veri ya da kullanım bilgisi çıkmaz. Her web isteğinde olduğu gibi GitHub IP adresinizi görebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac серйозно ставиться до вашої приватності, тому за промовчанням працює офлайн. Якщо захочете, можете дозволити йому раз на день перевіряти, чи вийшла нова версія. У GitHub запитується лише номер останньої версії. Жодні особисті дані чи відомості про використання не залишають ваш Mac. Як і за будь-якого вебзапиту, GitHub бачить вашу IP-адресу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac coi trọng quyền riêng tư của bạn, nên mặc định luôn ngoại tuyến. Nếu muốn, bạn có thể cho phép nó kiểm tra mỗi ngày một lần xem có phiên bản mới không. Chỉ số phiên bản mới nhất được yêu cầu từ GitHub. Không có dữ liệu cá nhân hay thông tin sử dụng nào rời khỏi máy Mac của bạn. Như mọi yêu cầu web khác, GitHub có thể thấy địa chỉ IP của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac 十分重视您的隐私，因此默认保持离线。如果您愿意，可以允许它每天检查一次是否有新版本。只会向 GitHub 请求最新的版本号。任何个人数据或使用信息都不会离开您的 Mac。与任何网络请求一样，GitHub 能看到您的 IP 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac 十分重視您的隱私，因此預設保持離線。如果您願意，可以允許它每天檢查一次是否有新版本。只會向 GitHub 要求最新的版本號碼。任何個人資料或使用資訊都不會離開您的 Mac。與任何網路請求一樣，GitHub 能看到您的 IP 位址。"
          }
        }
      }
    },
