    "The keyboard stays locked for %@ unless you unlock it sooner.": {
      "comment": "Full lockdown confirmation: how long the lock lasts. %@ is a duration such as 15 min.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur bleibt %@ lang gesperrt, sofern du nicht früher entsperrst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The keyboard stays locked for %@ unless you unlock it sooner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado permanecerá bloqueado %@ a menos que lo desbloquees antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier reste verrouillé pendant %@, sauf si vous le déverrouillez avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera resta bloccata per %@, a meno che tu non la sblocchi prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あらかじめ解除しない限り、キーボードは %@ ロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 해제하지 않으면 키보드는 %@ 동안 잠깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado ficará bloqueado por %@, a menos que você o desbloqueie antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура останется заблокированной на %@, если вы не разблокируете её раньше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye, daha önce açmazsanız %@ boyunca kilitli kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非您提前解锁，否则键盘将锁定 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非您提前解鎖，否則鍵盤將鎖定 %@。"
          }
        }
      }
    },
    "The keyboard unlocked because Accessibility access was turned off.": {
      "comment": "Shown in the panel after the lock ended because the Accessibility permission was revoked during the lock.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur wurde entsperrt, weil der Bedienungshilfen-Zugriff deaktiviert wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The keyboard unlocked because Accessibility access was turned off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado se desbloqueó porque se desactivó el acceso a Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier a été déverrouillé car l’accès à l’Accessibilité a été désactivé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera è stata sbloccata perché l’accesso all’Accessibilità è stato disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティのアクセスがオフになったため、キーボードのロックを解除しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한이 꺼져 키보드 잠금이 해제되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado foi desbloqueado porque o acesso à Acessibilidade foi desativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура разблокирована, потому что доступ к Универсальному доступу был отключён."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni kapatıldığı için klavyenin kilidi açıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限已关闭，键盘已解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用權限已關閉，鍵盤已解鎖。"
          }
        }
      }
    },
    "The keyboard unlocked because another app turned on secure input.": {
      "comment": "Shown in the panel after a full lockdown ended because another app turned on secure input (hold-Esc would not have worked).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur wurde entsperrt, weil eine andere App die sichere Eingabe aktiviert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The keyboard unlocked because another app turned on secure input."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado se desbloqueó porque otra app activó la entrada segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier a été déverrouillé car une autre app a activé la saisie sécurisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera è stata sbloccata perché un’altra app ha attivato l’inserimento sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリがセキュア入力をオンにしたため、キーボードのロックを解除しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱에서 보안 입력을 켜서 키보드 잠금이 해제되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado foi desbloqueado porque outro app ativou a entrada segura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура разблокирована, потому что другое приложение включило защищённый ввод."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir uygulama güvenli girişi açtığı için klavyenin kilidi açıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 App 打开了安全输入，键盘已解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個 App 開啟了安全輸入，鍵盤已解鎖。"
          }
        }
      }
    },
    "The keyboard unlocked because System Settings opened.": {
      "comment": "Shown in the panel after the lock ended because System Settings came forward (where Accessibility could be switched off).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur wurde entsperrt, weil die Systemeinstellungen geöffnet wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The keyboard unlocked because System Settings opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado se desbloqueó porque se abrió Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier a été déverrouillé car Réglages Système s’est ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera è stata sbloccata perché sono state aperte le Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定が開いたため、キーボードのロックを解除しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정이 열려 키보드 잠금이 해제되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado foi desbloqueado porque os Ajustes do Sistema foram abertos."
          }
        },
        "ru": {
