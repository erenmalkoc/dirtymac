          }
        }
      }
    },
    "How long to lock, from 1 to 60. Leave it empty to use the timer from Settings.": {
      "comment": "Description of the Minutes parameter of the Shortcuts action. 1 to 60 is the range the action accepts.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange gesperrt wird, von 1 bis 60. Leer lassen, um den Timer aus den Einstellungen zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long to lock, from 1 to 60. Leave it empty to use the timer from Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo bloquear, de 1 a 60. Déjalo vacío para usar el temporizador de Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée du verrouillage, de 1 à 60. Laissez vide pour utiliser le minuteur des Réglages."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa lama mengunci, dari 1 sampai 60. Biarkan kosong untuk memakai timer dari Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per quanto tempo bloccare, da 1 a 60. Lascia vuoto per usare il timer di Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックする時間(1〜60分)。空欄の場合は設定のタイマーを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠글 시간(1~60분)입니다. 비워 두면 설정의 타이머를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe lang vergrendelen, van 1 tot 60. Laat leeg om de timer uit Instellingen te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na jak długo zablokować, od 1 do 60. Zostaw puste, aby użyć timera z Ustawień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por quanto tempo bloquear, de 1 a 60. Deixe vazio para usar o temporizador de Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На сколько заблокировать, от 1 до 60. Оставьте пустым, чтобы использовать таймер из настроек."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kadar süre kilitleneceği, 1 ile 60 arası. Ayarlar'daki zamanlayıcıyı kullanmak için boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На скільки заблокувати, від 1 до 60. Залиште порожнім, щоб використати таймер із Налаштувань."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa trong bao lâu, từ 1 đến 60. Để trống để dùng bộ hẹn giờ trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定时长，1 到 60 分钟。留空则使用“设置”中的计时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定時長，1 到 60 分鐘。留空則使用「設定」中的計時。"
          }
        }
      }
    },
    "It has been %lld days since you installed this version. A newer one may be available. You can check the releases page, or turn on update checks in Settings.": {
      "comment": "Reminder in the panel, shown every 60 days to people who left update checks off. %lld is the number of days since this version was installed (always 60 or more).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit der Installation dieser Version sind %lld Tage vergangen. Möglicherweise ist eine neuere verfügbar. Du kannst die Seite mit den Versionen ansehen oder in den Einstellungen die Update-Prüfung einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It has been %lld days since you installed this version. A newer one may be available. You can check the releases page, or turn on update checks in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Han pasado %lld días desde que instalaste esta versión. Puede que haya una más reciente. Puedes consultar la página de versiones o activar la comprobación de actualizaciones en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fait %lld jours que vous avez installé cette version. Une version plus récente est peut-être disponible. Vous pouvez consulter la page des versions ou activer la recherche de mises à jour dans les Réglages."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah %lld hari sejak Anda memasang versi ini. Mungkin ada versi yang lebih baru. Anda bisa memeriksa halaman rilis, atau mengaktifkan pemeriksaan pembaruan di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono passati %lld giorni da quando hai installato questa versione. Potrebbe essercene una più recente. Puoi consultare la pagina delle versioni o attivare il controllo degli aggiornamenti in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンをインストールしてから %lld 日が経ちました。より新しいバージョンが公開されている可能性があります。リリースページを確認するか、設定でアップデートの確認をオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전을 설치한 지 %lld일이 지났습니다. 더 새로운 버전이 나왔을 수 있습니다. 릴리스 페이지를 확인하거나 설정에서 업데이트 확인을 켤 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is %lld dagen geleden dat je deze versie hebt geïnstalleerd. Er is mogelijk een nieuwere beschikbaar. Je kunt de pagina met releases bekijken of updatecontrole inschakelen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minęło %lld dni od zainstalowania tej wersji. Może być dostępna nowsza. Możesz sprawdzić stronę wydań lub włączyć sprawdzanie aktualizacji w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já se passaram %lld dias desde que você instalou esta versão. Pode haver uma mais recente. Você pode consultar a página de versões ou ativar a verificação de atualizações em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С момента установки этой версии прошло дней: %lld. Возможно, вышла более новая. Вы можете посмотреть страницу версий или включить проверку обновлений в настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürümü kurmanızın üzerinden %lld gün geçti. Daha yeni bir sürüm çıkmış olabilir. Sürümler sayfasına göz atabilir ya da Ayarlar'dan güncelleme denetimini açabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З моменту встановлення цієї версії минуло днів: %lld. Можливо, вийшла новіша. Можете переглянути сторінку випусків або ввімкнути перевірку оновлень у Налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã %lld ngày kể từ khi bạn cài phiên bản này. Có thể đã có bản mới hơn. Bạn có thể xem trang phát hành hoặc bật kiểm tra cập nhật trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自安装此版本以来已过去 %lld 天。可能已有更新的版本。您可以查看发布页面，或在“设置”中开启更新检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自安裝此版本以來已過了 %lld 天。可能已有更新的版本。您可以查看發佈頁面，或在「設定」中開啟更新檢查。"
          }
        }
      }
    },
