          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mouse será congelado. Segure Esc por 3 s para desbloquear."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мышь будет заморожена. Удерживайте Esc 3 с для разблокировки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
