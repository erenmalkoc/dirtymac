    "Allow in Login Items…": {
      "comment": "Link shown when the login item is registered but switched off in System Settings.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Anmeldeobjekten erlauben …"
          }
        },
