    "Mouse and trackpad keep working — click the icon again to unlock.": {
      "comment": "Onboarding step 3 tip 3.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maus und Trackpad funktionieren weiter – klicke erneut auf das Symbol zum Entsperren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse and trackpad keep working — click the icon again to unlock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ratón y el trackpad siguen funcionando: haz clic de nuevo en el icono para desbloquear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La souris et le trackpad continuent de fonctionner — cliquez à nouveau sur l'icône pour déverrouiller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse e trackpad continuano a funzionare: fai di nuovo clic sull'icona per sbloccare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスとトラックパッドは使えます。アイコンを再度クリックすると解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스와 트랙패드는 계속 작동합니다. 아이콘을 다시 클릭하면 잠금이 해제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mouse e o trackpad continuam funcionando — clique no ícone novamente para desbloquear."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мышь и трекпад продолжают работать — нажмите значок ещё раз, чтобы разблокировать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare ve trackpad çalışmaya devam eder — kilidi açmak için simgeye tekrar tıklayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
