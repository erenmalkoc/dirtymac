    "Mouse and trackpad will be frozen too.": {
      "comment": "Idle caption when Advanced mouse blocking is enabled.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maus und Trackpad werden ebenfalls eingefroren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse and trackpad will be frozen too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ratón y el trackpad también se congelarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La souris et le trackpad seront aussi figés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche mouse e trackpad saranno bloccati."
          }
