    "Quit that app, or lock and unlock your screen, to clear it.": {
      "comment": "Second line of the secure input warning: how to make the other app release secure input.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende diese App oder sperre und entsperre den Bildschirm, um sie aufzuheben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit that app, or lock and unlock your screen, to clear it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para quitarla, cierra esa app o bloquea y desbloquea la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour la désactiver, quittez cette app ou verrouillez puis déverrouillez l’écran."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar dari aplikasi itu, atau kunci lalu buka kunci layar Anda, untuk membersihkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per disattivarlo, chiudi quell’app oppure blocca e sblocca lo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解除するには、そのアプリを終了するか、画面をロックしてからロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해제하려면 해당 앱을 종료하거나 화면을 잠갔다가 잠금 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit die app af, of vergrendel en ontgrendel je scherm, om het te wissen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij tę aplikację albo zablokuj i odblokuj ekran, aby to wyczyścić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para desativá-la, encerre esse app ou bloqueie e desbloqueie a tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы отключить его, закройте это приложение или заблокируйте и разблокируйте экран."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatmak için o uygulamadan çıkın ya da ekranı kilitleyip kilidini açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрийте цю програму або заблокуйте й розблокуйте екран, щоб це скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thoát ứng dụng đó, hoặc khóa rồi mở khóa màn hình để xóa trạng thái này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要解除，请退出该 App，或锁定屏幕后再解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要解除，請結束該 App，或鎖定螢幕後再解鎖。"
          }
        }
      }
    },
