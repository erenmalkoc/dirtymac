          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「系統設定」已打開，鍵盤已解鎖。"
          }
        }
      }
    },
    "The keyboard unlocked when your Mac went to sleep.": {
      "comment": "Shown in the panel after the lock ended because the Mac went to sleep.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur wurde entsperrt, als dein Mac in den Ruhezustand ging."
          }
