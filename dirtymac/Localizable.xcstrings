    "The keyboard stays locked for %@, until %@, unless you unlock it sooner.": {
      "comment": "First %@ is a length such as '8 hr', second is the time of day it ends such as '23:30'.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur bleibt %@ lang gesperrt, bis %@, sofern du nicht früher entsperrst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The keyboard stays locked for %@, until %@, unless you unlock it sooner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado permanecerá bloqueado %@, hasta las %@, a menos que lo desbloquees antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier reste verrouillé pendant %@, jusqu'à %@, sauf si vous le déverrouillez avant."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard tetap terkunci selama %@, hingga %@, kecuali Anda membukanya lebih awal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera resta bloccata per %@, fino alle %@, a meno che tu non la sblocchi prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あらかじめ解除しない限り、キーボードは %@、%@ までロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 해제하지 않으면 키보드는 %@ 동안, %@까지 잠깁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het toetsenbord blijft %@ vergrendeld, tot %@, tenzij je het eerder ontgrendelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawiatura pozostanie zablokowana przez %@, do %@, chyba że odblokujesz ją wcześniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado ficará bloqueado por %@, até %@, a menos que você o desbloqueie antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура останется заблокированной на %@, до %@, если вы не разблокируете её раньше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye, daha önce açmazsanız %@ boyunca, %@ saatine kadar kilitli kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіатуру буде заблоковано на %@, до %@, якщо ви не розблокуєте її раніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn phím sẽ bị khóa trong %@, đến %@, trừ khi bạn mở khóa sớm hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非您提前解锁，否则键盘将锁定 %@，直到 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非您提前解鎖，否則鍵盤將鎖定 %@，直到 %@。"
          }
        }
      }
    },
    "To unlock sooner, click the menu bar icon or hold Esc for 3 seconds.": {
      "comment": "Hint in the long lock confirmation.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum früheren Entsperren klicke auf das Menüleistensymbol oder halte Esc 3 Sekunden gedrückt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To unlock sooner, click the menu bar icon or hold Esc for 3 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para desbloquear antes, haz clic en el icono de la barra de menús o mantén Esc 3 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour déverrouiller plus tôt, cliquez sur l'icône de la barre des menus ou maintenez Échap 3 secondes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk membuka kunci lebih awal, klik ikon di bar menu atau tahan Esc selama 3 detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per sbloccare prima, fai clic sull'icona nella barra dei menu oppure tieni premuto Esc per 3 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早く解除するには、メニューバーのアイコンをクリックするか、Esc を3秒間長押ししてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 일찍 해제하려면 메뉴 막대 아이콘을 클릭하거나 Esc를 3초간 길게 누르세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om eerder te ontgrendelen klik je op het symbool in de menubalk of houd je Esc 3 seconden ingedrukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby odblokować wcześniej, kliknij ikonę na pasku menu lub przytrzymaj Esc przez 3 sekundy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para desbloquear antes, clique no ícone na barra de menus ou segure Esc por 3 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы разблокировать раньше, нажмите на значок в строке меню или удерживайте Esc 3 секунды."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha erken açmak için menü çubuğu simgesine tıklayın ya da Esc'i 3 saniye basılı tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб розблокувати раніше, клацніть піктограму в рядку меню або утримуйте Esc 3 секунди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để mở khóa sớm hơn, hãy nhấp vào biểu tượng trên thanh menu hoặc giữ Esc trong 3 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需提前解锁，请点按菜单栏图标或长按 Esc 3 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如需提前解鎖，請點按選單列圖示或長按 Esc 3 秒。"
          }
        }
      }
    },
    "The lock ends early if the Mac goes to sleep or the screen locks.": {
      "comment": "Warning in the long lock confirmation.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sperre endet vorzeitig, wenn dein Mac in den Ruhezustand geht oder der Bildschirm gesperrt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock ends early if the Mac goes to sleep or the screen locks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo termina antes si tu Mac entra en reposo o se bloquea la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verrouillage prend fin plus tôt si votre Mac se met en veille ou si l'écran se verrouille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penguncian berakhir lebih awal jika Mac tidur atau layar terkunci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco termina prima se il Mac va in stop o lo schermo si blocca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac がスリープするか画面がロックされると、ロックは早く終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 잠자기 상태가 되거나 화면이 잠기면 잠금이 일찍 끝납니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vergrendeling eindigt eerder als je Mac in slaap valt of het scherm wordt vergrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokada kończy się wcześniej, jeśli Mac przejdzie w stan uśpienia lub ekran zostanie zablokowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio termina antes se o Mac entrar em repouso ou a tela for bloqueada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка снимется раньше, если Mac перейдёт в режим сна или экран будет заблокирован."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'iniz uyku moduna geçerse ya da ekran kilitlenirse kilit erken sona erer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокування завершиться раніше, якщо Mac перейде в сплячий режим або екран буде заблоковано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa sẽ kết thúc sớm nếu máy Mac chuyển sang chế độ ngủ hoặc màn hình bị khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Mac 进入睡眠或屏幕被锁定，锁定会提前结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Mac 進入睡眠或螢幕被鎖定，鎖定會提前結束。"
          }
        }
      }
    },
    "The screen stays on the whole time, which uses power.": {
      "comment": "Warning in the long lock confirmation, shown when Keep the screen awake is on.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm bleibt die ganze Zeit an, was Strom verbraucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen stays on the whole time, which uses power."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla permanece encendida todo el tiempo, lo que consume energía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écran reste allumé en permanence, ce qui consomme de l'énergie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar tetap menyala selama itu, sehingga memakai daya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo resta acceso per tutto il tempo, il che consuma energia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面はずっとオンのままになり、電力を消費します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 계속 켜져 있어 전력을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het scherm blijft de hele tijd aan, wat stroom kost."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran będzie włączony przez cały czas, co zużywa energię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela fica ligada o tempo todo, o que consome energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран всё это время остаётся включённым, что расходует энергию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran bu sürenin tamamında açık kalır, bu da enerji harcar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екран залишатиметься ввімкненим увесь цей час, що витрачає енергію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình sẽ sáng suốt thời gian này, việc đó tốn pin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕会一直保持亮起，这会耗电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕會一直保持亮著，這會耗電。"
          }
        }
      }
    },
