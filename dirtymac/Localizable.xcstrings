    "dirtymac": {
      "comment": "App brand name — do not translate.",
      "shouldTranslate": false
    },
    "dirtymac can start with your Mac, so it's always one shortcut away.": {
      "comment": "What's New 1.2.0 item detail.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac kann mit deinem Mac starten und ist so immer nur einen Kurzbefehl entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac can start with your Mac, so it's always one shortcut away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac puede abrirse al encender tu Mac, así siempre está a un atajo de distancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac peut démarrer avec votre Mac pour être toujours à un raccourci près."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac può avviarsi con il Mac, così è sempre a portata di scorciatoia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac を Mac と一緒に起動できるので、いつでもショートカットひとつで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac을 Mac과 함께 시작하면 언제든 단축키 하나로 쓸 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dirtymac pode iniciar com o Mac, ficando sempre a um atalho de distância."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac может запускаться вместе с Mac и всегда будет под рукой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac, Mac'inizle birlikte başlayabilir; böylece her zaman bir kısayol uzağınızda olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac 可以随 Mac 一起启动，随时一键可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "dirtymac 可以隨 Mac 一起啟動，隨時一鍵可用。"
          }
        }
      }
    },
