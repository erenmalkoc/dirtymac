          "stringUnit": {
            "state": "translated",
            "value": "Sperrt die Tastatur, damit du sie reinigen kannst. Halte Esc 3 Sekunden gedrückt, um zu entsperren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locks the keyboard so you can clean it. Hold Esc for 3 seconds to unlock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea el teclado para que puedas limpiarlo. Mantén Esc 3 segundos para desbloquear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille le clavier pour que vous puissiez le nettoyer. Maintenez Échap 3 secondes pour déverrouiller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca la tastiera così puoi pulirla. Tieni premuto Esc per 3 secondi per sbloccare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "掃除できるようにキーボードをロックします。Esc を3秒間長押しで解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "청소할 수 있도록 키보드를 잠급니다. 잠금을 해제하려면 Esc를 3초간 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia o teclado para você limpá-lo. Segure Esc por 3 segundos para desbloquear."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокирует клавиатуру, чтобы её можно было почистить. Удерживайте Esc 3 секунды, чтобы разблокировать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizleyebilmeniz için klavyeyi kilitler. Kilidi açmak için Esc'i 3 saniye basılı tutun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定键盘以便清洁。长按 Esc 3 秒解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定鍵盤以便清潔。長按 Esc 3 秒解鎖。"
          }
        }
      }
    },
