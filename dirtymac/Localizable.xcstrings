    "Hold Esc for 3 seconds to check that your way out works.": {
      "comment": "Full lockdown confirmation, shown for locks longer than 5 minutes. The Lock button stays off until the user has held Esc once.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte Esc 3 Sekunden gedrückt, um zu prüfen, dass dein Ausweg funktioniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Esc for 3 seconds to check that your way out works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén Esc 3 segundos para comprobar que tu salida funciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez Échap 3 secondes pour vérifier que votre issue de secours fonctionne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto Esc per 3 secondi per verificare che la tua via d'uscita funzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc を3秒間長押しして、解除の方法が使えることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc를 3초간 눌러 잠금 해제 방법이 작동하는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure Esc por 3 segundos para conferir se a sua saída funciona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте Esc 3 секунды, чтобы убедиться, что выход работает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkış yolunuzun çalıştığını denetlemek için Esc'i 3 saniye basılı tutun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按 Esc 3 秒，确认退出方式可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按 Esc 3 秒，確認退出方式可用。"
          }
        }
      }
    },
