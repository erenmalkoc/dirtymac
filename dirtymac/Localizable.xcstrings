          "stringUnit": {
            "state": "translated",
            "value": "滑鼠與觸控板也將被凍結。"
          }
        }
      }
    },
    "Mouse will be frozen. Hold Esc for 3s to force unlock.": {
      "comment": "Inline warning shown in Advanced when mouse blocking is on.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Maus wird eingefroren. Halte Esc 3 Sek. gedrückt, um zu entsperren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse will be frozen. Hold Esc for 3s to force unlock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ratón se congelará. Mantén Esc 3 s para desbloquear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La souris sera figée. Maintenez Échap 3 s pour déverrouiller."
          }
        },
        "it": {
