            "state": "translated",
            "value": "Клавиатура разблокирована, потому что открылись Системные настройки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları açıldığı için klavyenin kilidi açıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
